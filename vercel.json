{
	"version": 2,
	"builds": [
		{
			"src": "build_files.sh",
			"use": "@vercel/static-build",
			"config": { "distDir": "staticfiles" }
		},
		{
			"src": "eventMan/asgi.py",
			"use": "@vercel/python",
			"config": { "maxLambdaSize": "15mb", "runtime": "python3.12" }
		}
	],
	"routes": [
		{
			"src": "/static/(.*)",
			"dest": "/staticfiles/$1",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			}
		},
		{
			"src": "/(.*)",
			"dest": "eventMan/asgi.py"
		}
	]
}
